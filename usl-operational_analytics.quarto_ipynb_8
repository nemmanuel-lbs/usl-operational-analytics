    "#| label: tbl-cases-severity\n",
    "#| tbl-cap: Case volume by severity level\n",
    "sev_order = ['CRITICAL', 'HIGH', 'MEDIUM', 'LOW']\n",
    "c3 = (df['CASE_SEVERITY']\n",
    "      .value_counts()\n",
    "      .reindex(sev_order)\n",
    "      .reset_index()\n",
    "      .rename(columns={'CASE_SEVERITY': 'Severity', 'count': 'Cases'}))\n",
    "c3['Share'] = c3['Cases'] / c3['Cases'].sum()\n",
    "sev_bg = {\n",
    "    'CRITICAL': \"background: linear-gradient(90deg, rgba(215,38,61,0.18) 0%, transparent 100%)\",\n",
    "    'HIGH':     \"background: linear-gradient(90deg, rgba(244,96,54,0.18) 0%, transparent 100%)\",\n",
    "    'MEDIUM':   \"background: linear-gradient(90deg, rgba(244,162,97,0.18) 0%, transparent 100%)\",\n",
    "    'LOW':      \"background: linear-gradient(90deg, rgba(46,196,182,0.18) 0%, transparent 100%)\",\n",
    "}\n",
    "(c3.style\n",
    "   .format({\"Cases\": \"{:,}\", \"Share\": \"{:.1%}\"})\n",
    "   .apply(lambda row: [sev_bg.get(row['Severity'], \"\")] * len(row), axis=1)\n",
    "   .hide(axis=\"index\")\n",
    "   .set_table_attributes('class=\"dataframe\"'))"
   ]
