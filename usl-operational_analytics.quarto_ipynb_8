    "#| label: km\n",
    "#| fig-cap: Kaplan-Meier — probability of NO SLA breach yet, by product\n",
    "kmf = KaplanMeierFitter()\n",
    "fig = go.Figure()\n",
    "\n",
    "km_colors = {\"KACHASI v2.x\": \"#2E86AB\", \"KACHASI v1.x\": \"#A23B72\",\n",
    "             \"TENTACLES\": \"#F18F01\", \"DATASTORE\": \"#44BBA4\"}\n",
    "\n",
    "# ── SLA threshold zones (shaded vertical bands behind curves) ──\n",
    "sla_bands = [\n",
    "    (0.1,    24,  \"CRITICAL<br>≤ 24h\", \"#FDECEC\"),\n",
    "    (24,     72,  \"HIGH<br>≤ 72h\",     \"#FFF3E0\"),\n",
    "    (72,    120,  \"MEDIUM<br>≤ 120h\",  \"#F0F4C3\"),\n",
    "    (120,   240,  \"LOW<br>≤ 240h\",     \"#E8F5E9\"),\n",
    "]\n",
    "for x0, x1, label, bgcolor in sla_bands:\n",
    "    fig.add_vrect(\n",
    "        x0=x0, x1=x1,\n",
    "        fillcolor=bgcolor, opacity=0.55, layer=\"below\", line_width=0,\n",
    "    )\n",
    "    fig.add_annotation(\n",
    "        x=np.log10(np.sqrt(x0 * x1)) if x0 > 0 else np.log10(x1 / 2),\n",
    "        y=1.02, yref=\"y domain\",\n",
    "        text=f\"<b>{label}</b>\",\n",
    "        font=dict(size=8.5, color=\"#555\"),\n",
    "        showarrow=False, xref=\"x\"\n",
    "    )\n",
    "\n",
    "# ── Survival curves — clean lines, no fill ──\n",
    "for prod in sorted(km_colors.keys()):\n",
    "    msk = df[\"PRODUCT_NAME\"] == prod\n",
    "    if msk.sum() == 0:\n",
    "        continue\n",
    "    kmf.fit(df.loc[msk, \"RESOLUTION_TIME_HOURS\"],\n",
    "            df.loc[msk, \"BREACH\"], label=prod)\n",
    "    sf = kmf.survival_function_\n",
    "    t  = sf.index.tolist()\n",
    "    s  = sf.iloc[:, 0].tolist()\n",
    "    n  = int(msk.sum())\n",
    "    col = km_colors[prod]\n",
    "\n",
    "    # Step shape\n",
    "    t_step, s_step = [], []\n",
    "    for i in range(len(t) - 1):\n",
    "        t_step += [t[i], t[i+1]]\n",
    "        s_step += [s[i], s[i]]\n",
    "    t_step.append(t[-1]); s_step.append(s[-1])\n",
    "\n",
    "    fig.add_trace(go.Scatter(\n",
    "        x=t_step, y=s_step,\n",
    "        mode=\"lines\",\n",
    "        name=f\"{prod}  (n = {n:,})\",\n",
    "        line=dict(color=col, width=3),\n",
    "        hovertemplate=(\n",
    "            \"<b>\" + prod + \"</b><br>\"\n",
    "            \"Hours: %{x:,.1f}<br>\"\n",
    "            \"Survival: %{y:.1%}<extra></extra>\"\n",
    "        )\n",
    "    ))\n",
    "\n",
    "# ── 50% survival reference ──\n",
    "fig.add_hline(y=0.5,\n",
    "              line=dict(color=\"#AAAAAA\", width=1, dash=\"dash\"))\n",
    "fig.add_annotation(\n",
    "    x=1.0, y=0.50, xref=\"paper\",\n",
    "    text=\"50 % survival\", font=dict(size=9, color=\"#999\"),\n",
    "    showarrow=False, xanchor=\"left\", xshift=5\n",
    ")\n",
    "\n",
    "fig.update_xaxes(\n",
    "    type=\"log\",\n",
    "    title_text=\"Hours since case opened (log scale)\",\n",
    "    showgrid=False,\n",
    "    showspikes=True, spikemode=\"across\",\n",
