    "#| label: forecast\n",
    "# Use only cases with parseable dates (from case reference pattern PREFIX/DD/MM/NNNN)\n",
    "m = (df.dropna(subset=[\"CREATED_DATE\"])\n",
    "       .set_index(\"CREATED_DATE\")\n",
    "       .resample(\"MS\").size()\n",
    "       .rename(\"cases\")\n",
    "       .asfreq(\"MS\", fill_value=0))\n",
    "\n",
    "mod = Holt(m, initialization_method=\"estimated\").fit(optimized=True)\n",
    "fc = mod.forecast(6).round()\n",
    "sd = (m - mod.fittedvalues).std()\n",
    "ci_low, ci_high = fc - 1.96*sd, fc + 1.96*sd\n",
    "\n",
    "obs_x  = [str(t.date()) for t in m.index]\n",
    "fc_x   = [str(t.date()) for t in fc.index]\n",
    "\n",
    "fig = go.Figure()\n",
    "\n",
    "# ── 95% confidence band ──\n",
    "fig.add_trace(go.Scatter(\n",
