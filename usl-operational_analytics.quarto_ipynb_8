    "#| label: mc-plot\n",
    "#| fig-cap: Monte Carlo distributions of total annual cost by scenario\n",
    "mc_colors = {\"A. Status quo\": \"#6C757D\", \"B. +2 L2 engineers\": \"#2E86AB\",\n",
    "             \"C. Pod re-org\": \"#F18F01\", \"D. Comprehensive\": \"#D7263D\"}\n",
    "\n",
    "fig = ps.make_subplots(\n",
    "    rows=1, cols=2, column_widths=[0.62, 0.38],\n",
    "    subplot_titles=[\"<b>Cost Distribution by Scenario</b>\",\n",
    "                    \"<b>Scenario Comparison — Key Percentiles</b>\"],\n",
    "    horizontal_spacing=0.10\n",
    ")\n",
    "\n",
    "# ── Panel 1: overlapping histograms ──\n",
    "for name, arr in results.items():\n",
    "    col = mc_colors[name]\n",
    "    fig.add_trace(go.Histogram(\n",
    "        x=arr / 1e6, nbinsx=70,\n",
    "        opacity=0.50, name=name,\n",
    "        marker=dict(color=col, line=dict(width=0.3, color=col)),\n",
    "        legendgroup=name,\n",
    "        hovertemplate=\"Cost: $%{x:.2f}M<br>Count: %{y:,}<extra>\" + name + \"</extra>\"\n",
    "    ), row=1, col=1)\n",
    "\n",
    "# ── P95 markers as staggered annotations (no overlap) ──\n",
    "p95_vals = {name: np.percentile(arr, 95) / 1e6 for name, arr in results.items()}\n",
    "y_offsets = [0.97, 0.88, 0.79, 0.70]  # stagger from top\n",
    "for (name, p95), yref in zip(p95_vals.items(), y_offsets):\n",
    "    col = mc_colors[name]\n",
    "    fig.add_vline(x=p95, line=dict(color=col, width=1.5, dash=\"dot\"), row=1, col=1)\n",
    "    fig.add_annotation(\n",
    "        x=p95, y=yref,\n",
    "        xref=\"x\", yref=\"y domain\",\n",
    "        text=f\"<b>P95</b> ${p95:.2f}M\",\n",
    "        font=dict(size=9, color=\"white\", family=\"monospace\"),\n",
    "        bgcolor=col, borderpad=3, bordercolor=col,\n",
    "        showarrow=True, arrowhead=0, arrowwidth=1, arrowcolor=col,\n",
    "        ax=30, ay=0\n",
    "    )\n",
    "\n",
    "# ── Panel 2: box plots ──\n",
    "for name, arr in results.items():\n",
    "    col = mc_colors[name]\n",
    "    fig.add_trace(go.Box(\n",
    "        y=arr / 1e6, name=name.split(\". \")[1],\n",
    "        marker_color=col, boxmean=True,\n",
    "        legendgroup=name, showlegend=False,\n",
    "        hovertemplate=\"<b>\" + name + \"</b><br>Value: $%{y:.2f}M<extra></extra>\"\n",
    "    ), row=1, col=2)\n",
    "\n",
    "fig.update_layout(\n",
    "    barmode=\"overlay\", height=490,\n",
    "    title=dict(text=\"<b>Monte Carlo — 10,000 Simulations of Total Annual Exposure</b>\",\n",
    "               font=dict(size=15)),\n",
    "    template=\"plotly_white\",\n",
    "    font=dict(family=\"Segoe UI, Helvetica, Arial, sans-serif\", size=12),\n",
    "    legend=dict(orientation=\"h\", yanchor=\"bottom\", y=1.05, xanchor=\"center\", x=0.31,\n",
    "                font=dict(size=11)),\n",
    "    hoverlabel=dict(bgcolor=\"white\", font_size=11, font_family=\"monospace\"),\n",
    "    margin=dict(t=95, b=45)\n",
    ")\n",
    "fig.update_xaxes(title_text=\"12-month total cost (USD millions)\", row=1, col=1)\n",
    "fig.update_yaxes(title_text=\"Frequency\", row=1, col=1)\n",
    "fig.update_yaxes(title_text=\"Cost (USD millions)\", row=1, col=2)\n",
    "fig.show()"
