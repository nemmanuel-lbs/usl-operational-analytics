    "X = v.fit_transform(df[\"title_clean\"])\n",
    "y = df[\"CASE_SEVERITY\"]\n",
    "\n",
    "cv = StratifiedKFold(5, shuffle=True, random_state=1)\n",
    "acc = cross_val_score(LogisticRegression(max_iter=400, C=2),\n",
    "                      X, y, cv=cv).mean()\n",
    "\n",
    "clf = LogisticRegression(max_iter=400, C=2).fit(X, y)\n",
    "fn = v.get_feature_names_out()\n",
    "top_features = {c: [fn[j] for j in np.argsort(clf.coef_[i])[-7:][::-1]]\n",
    "                for i, c in enumerate(clf.classes_)}"
