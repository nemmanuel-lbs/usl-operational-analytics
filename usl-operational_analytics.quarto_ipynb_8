   "source": [
    "#| label: load\n",
    "import re\n",
    "\n",
    "df = pd.read_csv(DATA_PATH)\n",
    "\n",
    "# Extract day/month from case references (format: PREFIX/DD/MM/NNNN)\n",
    "def _parse_ref_date(ref):\n",
    "    m = re.match(r\"^[A-Z]+/(\\d{2})/(\\d{2})/\\d+$\", str(ref))\n",
    "    if m:\n",
    "        dd, mm = int(m.group(1)), int(m.group(2))\n",
    "        try:\n",
    "            return pd.Timestamp(f\"2025-{mm:02d}-{dd:02d}\")\n",
    "        except ValueError:\n",
    "            return pd.NaT\n",
    "    return pd.NaT\n",
    "\n",
    "df[\"CREATED_DATE\"] = df[\"CASE_REFERENCE\"].apply(_parse_ref_date)\n",
    "df[\"MONTH\"]        = df[\"CREATED_DATE\"].dt.to_period(\"M\").dt.to_timestamp()\n",
    "\n",
    "print(f\"Rows: {df.shape[0]:,}    Columns: {df.shape[1]}\")\n",
    "dated = df[\"CREATED_DATE\"].notna().sum()\n",
    "print(f\"Cases with parseable date: {dated:,} of {df.shape[0]:,}\")\n",
    "print(f\"Date span (where available): {df['CREATED_DATE'].min().date()} → {df['CREATED_DATE'].max().date()}\")"
   ]
