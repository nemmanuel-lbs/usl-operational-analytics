    "#| label: lp-plot\n",
    "#| fig-cap: Optimal sprint capacity allocation\n",
    "# Colour-code bars by value-per-point intensity\n",
    "vpp      = lp_out[\"ValuePerPoint\"].tolist()\n",
    "vpp_norm = [(v - min(vpp)) / (max(vpp) - min(vpp) + 1e-9) for v in vpp]\n",
    "bar_cols = [f\"rgba({int(215*n + 46*(1-n))},{int(38*n + 134*(1-n))},{int(61*n + 171*(1-n))},0.85)\"\n",
    "            for n in vpp_norm]  # gradient from cool blue → hot red\n",
    "\n",
    "fig = ps.make_subplots(\n",
    "    rows=1, cols=2, column_widths=[0.62, 0.38],\n",
    "    specs=[[{\"type\": \"xy\"}, {\"type\": \"pie\"}]],\n",
    "    subplot_titles=[\"<b>Points Allocated per Track</b>\",\n",
    "                    \"<b>Share of Sprint Capacity</b>\"],\n",
    "    horizontal_spacing=0.08\n",
    ")\n",
    "\n",
    "# ── Bar chart with min/max constraint markers ──\n",
    "tracks   = lp_out[\"Track\"].tolist()\n",
    "opt_pts  = lp_out[\"Optimal_pts\"].tolist()\n",
    "min_pts  = items[\"Min\"].tolist()\n",
    "max_pts  = items[\"Max\"].tolist()\n",
    "\n",
    "fig.add_trace(go.Bar(\n",
    "    x=opt_pts, y=tracks,\n",
    "    orientation=\"h\",\n",
    "    marker=dict(color=bar_cols,\n",
    "                line=dict(width=1, color=\"#333\")),\n",
    "    text=[f\"<b>{v} pts</b>  (${val:.0f} value)\" for v, val in zip(opt_pts, lp_out[\"Value\"])],\n",
    "    textposition=\"outside\",\n",
    "    textfont=dict(size=11),\n",
    "    hovertemplate=(\n",
    "        \"<b>%{y}</b><br>\"\n",
    "        \"Allocated: %{x} pts<br>\"\n",
    "        \"Value/pt: $%{customdata[0]:.1f}<br>\"\n",
    "        \"Min: %{customdata[1]}  |  Max: %{customdata[2]}<br>\"\n",
    "        \"Total value: $%{customdata[3]:.0f}<extra></extra>\"\n",
    "    ),\n",
    "    customdata=list(zip(vpp, min_pts, max_pts, lp_out[\"Value\"].tolist())),\n",
    "    showlegend=False\n",
    "), row=1, col=1)\n",
    "\n",
    "# Min constraint diamonds\n",
    "fig.add_trace(go.Scatter(\n",
    "    x=min_pts, y=tracks,\n",
    "    mode=\"markers\", name=\"Min constraint\",\n",
    "    marker=dict(symbol=\"diamond\", size=10, color=\"#F18F01\",\n",
    "                line=dict(width=1.5, color=\"#333\")),\n",
    "    hovertemplate=\"<b>%{y}</b> — Min floor: %{x} pts<extra></extra>\"\n",
    "), row=1, col=1)\n",
    "\n",
    "# Max constraint diamonds\n",
    "fig.add_trace(go.Scatter(\n",
    "    x=max_pts, y=tracks,\n",
    "    mode=\"markers\", name=\"Max cap\",\n",
    "    marker=dict(symbol=\"diamond\", size=10, color=\"#D7263D\",\n",
    "                line=dict(width=1.5, color=\"#333\")),\n",
    "    hovertemplate=\"<b>%{y}</b> — Max cap: %{x} pts<extra></extra>\"\n",
    "), row=1, col=1)\n",
    "\n",
    "# ── Donut chart for share breakdown ──\n",
    "fig.add_trace(go.Pie(\n",
    "    labels=tracks, values=opt_pts,\n",
    "    hole=0.45,\n",
    "    marker=dict(colors=bar_cols,\n",
    "                line=dict(width=2, color=\"white\")),\n",
    "    textinfo=\"label+percent\",\n",
    "    textfont=dict(size=11),\n",
    "    hovertemplate=\"<b>%{label}</b><br>%{value} pts (%{percent})<extra></extra>\",\n",
    "    showlegend=False\n",
    "), row=1, col=2)\n",
    "\n",
    "# Centre annotation for donut\n",
    "fig.add_annotation(\n",
    "    text=f\"<b>240</b><br>total pts\",\n",
    "    x=0.82, y=0.5, xref=\"paper\", yref=\"paper\",\n",
    "    font=dict(size=14, color=\"#333\"), showarrow=False\n",
    ")\n",
    "\n",
    "fig.update_layout(\n",
    "    title=dict(text=\"<b>Optimal Sprint Capacity Allocation (240 SP)</b>\",\n",
    "               font=dict(size=15)),\n",
    "    template=\"plotly_white\",\n",
    "    font=dict(family=\"Segoe UI, Helvetica, Arial, sans-serif\", size=12),\n",
    "    height=420,\n",
    "    legend=dict(orientation=\"h\", yanchor=\"bottom\", y=-0.15,\n",
    "                xanchor=\"center\", x=0.31, font=dict(size=11)),\n",
    "    hoverlabel=dict(bgcolor=\"white\", font_size=11, font_family=\"monospace\"),\n",
    "    margin=dict(t=80, b=30)\n",
    ")\n",
    "fig.update_xaxes(title_text=\"Story points\", range=[0, max(max_pts) * 1.35], row=1, col=1)\n",
    "fig.show()"
   ]
